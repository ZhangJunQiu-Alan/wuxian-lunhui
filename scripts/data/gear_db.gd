static func item_id(set_id: String, slot: String) -> String:
	return set_id + "_" + slot


## 装备 id 是不是一件真的装备（存档里的旧 id、乱写的 id 都会被丢掉）
static func is_item(id: String) -> bool:
	return SETS.has(set_of(id)) and SLOTS.has(slot_of(id))


static func set_of(id: String) -> String:
	return id.substr(0, id.rfind("_"))


static func slot_of(id: String) -> String:
	return id.substr(id.rfind("_") + 1)


static func piece(id: String) -> Dictionary:
	return SETS[set_of(id)].pieces[slot_of(id)]


static func icon(id: String) -> Texture2D:
	return load(ICON_DIR + str(piece(id).icon) + ".png")


static func set_icon(set_id: String) -> Texture2D:
	return load(SET_ICON_DIR + set_id + ".png")


## 某一关掉落的套装 id
static func sets_of_level(level_id: String) -> Array[String]:
	var result: Array[String] = []
	for set_id: String in SETS:
		if SETS[set_id].level == level_id:
			result.append(set_id)
	return result


## 某一关掉落的全部装备 id
static func items_of_level(level_id: String) -> Array[String]:
	var result: Array[String] = []
	for set_id in sets_of_level(level_id):
		for slot: String in SLOTS:
			result.append(item_id(set_id, slot))
	return result


## 一套里已经拥有几件
static func owned_count(set_id: String) -> int:
	var count := 0
	for slot: String in SLOTS:
		if Save.gear.has(item_id(set_id, slot)):
			count += 1
	return count


## 一套里正穿着几件
static func worn_count(set_id: String) -> int:
	var count := 0
	for slot: String in SLOTS:
		if Save.equipped.get(slot, "") == item_id(set_id, slot):
			count += 1
	return count


## 穿齐 4 件的套装 id，没有就返回空字符串（一共只有 4 个部位，所以同时最多激活一套）
static func active_set() -> String:
	var helm: String = Save.equipped.get("helm", "")
	if helm == "":
		return ""
	var set_id := set_of(helm)
	return set_id if worn_count(set_id) >= SET_SIZE else ""
