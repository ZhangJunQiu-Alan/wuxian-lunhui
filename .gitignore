# Godot 4
.godot/
/android/
*.translation

# 导出产物
/build/

# 系统
.DS_Store

# 压缩包不进仓库（源文件请解压后放入 assets/source）
*.zip

# Blender 自动备份
*.blend1

# Codex 制作脚本的缓存、可由脚本重新生成的试听文件
__pycache__/
*.pyc
assets/source/taskB_audio_*/previews/

# 制作目录内由 Godot 扫描生成的元数据；正式素材导入参数仍保留
assets/source/**/*.import
assets/source/**/*.gd.uid

# 剑士 3D 阶段 4：Tripo / Mixamo 原始下载只留本机（体积大；Mixamo 原始动作不可单独再分发）
assets/source/characters/swordsman_3d/04_绑骨/输入/
assets/source/characters/swordsman_3d/04_绑骨/候选/tripo/
assets/source/characters/swordsman_3d/04_绑骨/候选/mixamo/

# 敌人 3D：Tripo 原始导出只留本机
assets/source/敌人3D/03_模型/Tripo原始导出/

# 敌人 3D 阶段 4：Tripo / Mixamo 原始下载只留本机
assets/source/敌人3D/04_绑骨/原始下载/
