<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0">
  <head>
    <title>诸界余烬 · 游戏内容思维导图</title>
  </head>
  <body>
    <outline text="诸界余烬">
      <outline text="01 · 游戏循环与操作">
        <outline text="游戏定位">
          <outline text="俯视角生存战斗：移动走位，武器与神术自动攻击" />
          <outline text="局内随机构筑：职业武器＋神明信仰＋通用属性" />
          <outline text="局外持续成长：结算货币、解锁化身、永久强化、图鉴记录" />
        </outline>
        <outline text="一次轮回">
          <outline text="主神空间：选择化身 → 选择已解锁关卡 → 购买永久强化" />
          <outline text="进入关卡：等级 1 → 选第一位神 → 战斗与探索" />
          <outline text="战斗中：击杀 → 拾取经验 → 升级选卡 → 质变／觉醒／融合" />
          <outline text="探索中：普通支线、隐藏支线、宝箱、战斗补给" />
          <outline text="三位 Boss 全部击败 → 通关结算；死亡或放弃 → 结束本局" />
          <outline text="返回大厅：保留局外进度；下一局重新构筑" />
        </outline>
        <outline text="操作">
          <outline text="WASD／方向键：移动，自动瞄准与攻击" />
          <outline text="空格：沿朝向冲刺 150 像素；冷却 2 秒" />
          <outline text="冲刺防护：冲刺过程无敌，落地额外无敌 0.12 秒" />
          <outline text="E：大招能量充满后释放" />
          <outline text="Esc：暂停与局内菜单" />
        </outline>
        <outline text="关卡节奏">
          <outline text="当前目标约 10 分钟，时间到不会自动判负" />
          <outline text="03:00／06:00／09:00：三位 Boss 依次到场" />
          <outline text="前一位 Boss 仍存活：后续 Boss 等待" />
          <outline text="Boss 战：常规小怪刷新频率减半" />
          <outline text="暂停、升级选卡期间：战斗计时暂停" />
        </outline>
        <outline text="界面与反馈">
          <outline text="战斗 HUD：生命、经验、等级、大招、信仰、计时、击杀、任务、Boss 血条" />
          <outline text="大招特写：化身最璀璨的时刻、职业台词、技能名" />
          <outline text="设置：中英文、音量、窗口／全屏、垂直同步、帧率、伤害数字、震动" />
          <outline text="战斗中不切换语言；设置即时保存" />
        </outline>
      </outline>
      <outline text="02 · 人物职业与基础武器">
        <outline text="共同结构">
          <outline text="每个职业：基础生命／移速＋专属武器＋被动＋大招" />
          <outline text="每局只携带所选职业的一把基础武器，只抽到自己的武器卡" />
          <outline text="武器与神术分开成长；大招与冲刺不占神明名额" />
          <outline text="当前所有职业基础选项数均为 4；法师没有额外第 5 项" />
        </outline>
        <outline text="剑士 · 东方剑客">
          <outline text="定位：近战扇形清场；初始解锁" />
          <outline text="基础：生命 110；移速 220" />
          <outline text="太刀：基础伤害 14；间隔 1 秒；范围 110 像素" />
          <outline text="二刀流：每第 4 刀前后双斩，该刀伤害翻倍" />
          <outline text="次元斩：50 击杀充能；定住屏内敌人，裂痕爆发造成全屏伤害" />
          <outline text="武器成长">
            <outline text="锋利：伤害；居合：攻击间隔；长刃：攻击范围" />
            <outline text="回身斩：每次也斩身后；震退：击退；断筋：命中减速" />
          </outline>
        </outline>
        <outline text="枪手 · 西部神枪手">
          <outline text="定位：中距离连射与移动爆发；累计通关 1 次解锁" />
          <outline text="基础：生命 90；移速 230" />
          <outline text="左轮：基础伤害 7；射击间隔 0.28 秒；射程 460 像素" />
          <outline text="弹匣：6 发；换弹基础时间 1 秒" />
          <outline text="纸牌神射：弹匣末发伤害 ×3，命中后分裂两发" />
          <outline text="狂野西部秀：60 击杀充能；持续 8 秒">
            <outline text="射速 ×4、无需换弹、增加穿透、移速 +30%、击杀回血" />
          </outline>
          <outline text="武器成长">
            <outline text="重弹：伤害；快拔：射击间隔；扩容：弹匣与换弹" />
            <outline text="穿甲：穿透；双枪：同时射出两发" />
          </outline>
        </outline>
        <outline text="刺客 · 鬼面刺客">
          <outline text="定位：短距离高频攻击、包围增伤；累计完成 3 个支线解锁" />
          <outline text="基础：生命 85；移速 245" />
          <outline text="双刃：基础伤害 8；间隔 0.32 秒；范围 75 像素" />
          <outline text="破阵：150 像素内每个敌人使双刃伤害 +6%，最高 +60%" />
          <outline text="入阵曲：60 击杀充能；无敌瞬移连斩最多 15 个不同目标，最后骑兵幻影横扫" />
          <outline text="武器成长">
            <outline text="淬锋：伤害；疾袭：攻击间隔；突进：攻击范围" />
            <outline text="三连刺：对目标追加一次 50% 伤害的攻击（按现有卡名保留）" />
          </outline>
        </outline>
        <outline text="法师 · 大魔法师">
          <outline text="定位：环形清场、击退与安全区域；花费 3 点支线剧情点解锁" />
          <outline text="基础：生命 100；移速 210" />
          <outline text="奥术新星：基础伤害 12；间隔 1.3 秒；半径 170 像素" />
          <outline text="先知：文本为升级四选一；当前已成为全职业共同规则" />
          <outline text="巨石阵：60 击杀充能；巨石落地伤害，随后维持 8 秒阻挡区域" />
          <outline text="武器成长">
            <outline text="增幅：伤害；吟唱：攻击间隔；扩散：范围" />
            <outline text="回响：每次额外释放一圈新星" />
          </outline>
        </outline>
      </outline>
      <outline text="03 · 属性与战斗状态">
        <outline text="输出属性">
          <outline text="力量：全局伤害；武器、神术与大招读取全局伤害倍率" />
          <outline text="暴击：通用暴击率；普通暴击伤害 ×2" />
          <outline text="急速：只缩短基础武器冷却" />
          <outline text="冷却缩短：只缩短神术冷却" />
          <outline text="全攻击冷却：永久强化“专注”和部分支线共同影响" />
          <outline text="武器专属参数：伤害、范围、攻击间隔、击退、穿透、弹匣等" />
        </outline>
        <outline text="生存属性">
          <outline text="体魄：最大生命增加，并回复同等生命" />
          <outline text="再生：每秒自动回复生命" />
          <outline text="闪避：按概率规避直接攻击；不能规避持续伤害" />
          <outline text="受击保护：普通受击后 0.5 秒无敌" />
          <outline text="护盾：巴德尔誓言层数、补给的一次抵挡" />
          <outline text="特殊无敌：冲刺、刺客大招、巴德尔觉醒；触发条件各自独立" />
          <outline text="复活：消耗次数，恢复 50% 最大生命，短暂无敌并震开敌人" />
        </outline>
        <outline text="机动与成长属性">
          <outline text="迅捷：移动速度" />
          <outline text="引力：经验等拾取范围；基础拾取半径 90 像素" />
          <outline text="智慧：经验收益倍率" />
          <outline text="幸运：提高稀有以上卡牌出现概率" />
          <outline text="选项数：基础 4；命运白线可在本局 +1" />
          <outline text="重抽次数：永久强化提供；普通选卡和选神可消耗" />
        </outline>
        <outline text="通用属性卡数值">
          <outline text="四档顺序：普通／稀有／史诗／传说；次数上限按每种卡计算" />
          <outline text="力量：+10／15／22／30% 全伤害；最多 5 次" />
          <outline text="暴击：+5／7.5／11／15 个百分点；最多 4 次" />
          <outline text="冷却缩短：神术冷却 -5／7.5／11／15%；最多 4 次" />
          <outline text="急速：武器冷却 -8／12／18／24%；最多 3 次" />
          <outline text="幸运：+3／4.5／6.5／9 个百分点；最多 3 次" />
          <outline text="迅捷：移速 +8／12／17／24%；最多 3 次" />
          <outline text="体魄：生命 +20／30／44／60；最多 5 次" />
          <outline text="引力：拾取范围 +30／45／66／90%；最多 3 次" />
          <outline text="智慧：经验 +15／22／33／45%；最多 3 次" />
          <outline text="闪避：+8／12／17／24 个百分点；最多 2 次" />
          <outline text="再生：每秒 +1／1.5／2.2／3 生命；最多 3 次" />
        </outline>
        <outline text="敌方状态与配合">
          <outline text="感电：托尔；可发展为电网、连锁爆破" />
          <outline text="符文：奥丁；3 层引爆，分支可传播印记" />
          <outline text="灼烧：洛基、阳光之剑等；离开伤害区后仍持续掉血" />
          <outline text="迷惑：敌人改为攻击同伴；Boss 不受迷惑" />
          <outline text="拣选：弗蕾亚；击杀后可能产生治疗金羽" />
          <outline text="光痕：巴德尔；死亡爆光，可与符文／灼烧联动" />
          <outline text="溺水：澜；受到范围伤害 +20%" />
          <outline text="金网：澜觉醒；进一步提高受到的伤害" />
          <outline text="霜冻：斯卡蒂；叠到 5 层冻结" />
          <outline text="控制：减速、击退、麻痹、定身、冻结；精英／Boss 有不同抗性" />
          <outline text="玩家负面状态：恐惧、环境减速、冥雾／毒池等持续伤害" />
        </outline>
        <outline text="属性来源">
          <outline text="职业基础 → 永久强化 → 局内属性卡 → 武器／神术卡 → 支线 → 临时补给" />
          <outline text="跨关保留：永久强化；本局属性与技能重新开始" />
          <outline text="伤害、经验等部分倍率相加；冷却、移速等部分倍率相乘，不统一按简单加总理解" />
        </outline>
      </outline>
      <outline text="04 · 局内升级与技能成长">
        <outline text="等级成长">
          <outline text="等级 1 起步，上限 40；共 39 次经验升级" />
          <outline text="首次升级 5 经验，后续每级需求递增 6" />
          <outline text="到达 40 级累计需要 4,641 点实际入账经验" />
          <outline text="满级最后一次仍选卡；满级后经验清零，不再经验升级" />
          <outline text="满级仍可获得宝箱与支线独立选卡奖励" />
        </outline>
        <outline text="选卡体系">
          <outline text="普通升级：职业武器卡、通用属性卡、已信仰神明的强化卡" />
          <outline text="有可用神明强化卡时：至少提供一张神明强化卡" />
          <outline text="稀有度基础概率：普通 60%、稀有 28%、史诗 10%、传说 2%" />
          <outline text="战斗每分钟：稀有以上的总权重增加 2 个百分点，幸运再提供加成" />
          <outline text="每张强化卡有次数上限；卡池完全抽空时保底为“蜜酒”：回复 30 生命" />
          <outline text="无数值型武器卡：稀有／史诗／传说额外附带武器伤害 +10／20／30%" />
        </outline>
        <outline text="信仰成长主链">
          <outline text="等级 1／5／10／15：分别选择一位新神；最多 4 位" />
          <outline text="八位神开局均可进入候选池；后续只选未信仰的神" />
          <outline text="洛基与巴德尔不会同次候选出现，但可以在不同次选神中同时拥有" />
          <outline text="选神 → 获得基础神术，初始信仰 1" />
          <outline text="每选择一次该神强化卡 → 固定信仰 +1，稀有度不改变信仰增量" />
          <outline text="信仰 6 → 该神三条质变路线选一条，改变技能形态" />
          <outline text="信仰 12 → 获得已选路线对应的觉醒" />
          <outline text="觉醒后 → 该神强化卡退出普通升级、重抽、宝箱与支线选卡池" />
          <outline text="两位神都觉醒＋存在配对 → 弹出融合技奖励；无需占新神明名额" />
          <outline text="支线有直接加信仰的特例，如信仰洛基时完成“不肯哭泣的女巨人”" />
        </outline>
        <outline text="槽位与成长资源">
          <outline text="主要战斗技能：1 把职业武器＋最多 4 个神术" />
          <outline text="质变、觉醒、融合：在已有技能上变化，不新增主要技能槽" />
          <outline text="大招、被动、冲刺、通用属性：独立于上述槽位" />
          <outline text="单神从信仰 1 到 12：通常需要 11 张该神强化卡" />
          <outline text="四神全觉醒通常需 44 张神明强化卡；39 次经验升级中 3 次用于选神，另需考虑宝箱／支线收益" />
          <outline text="这是选择数量约束，不表示一局必定能获得四神全觉醒" />
        </outline>
      </outline>
      <outline text="05 · 八位神明与融合技能">
        <outline text="托尔 · 雷神｜爆发、范围、连锁">
          <outline text="基础：落雷；命中附加感电" />
          <outline text="四个强化方向：风暴＝雷数；雷域＝范围；麻痹＝控制概率；回响＝再次落雷" />
          <outline text="妙尔尼尔 → 觉醒·妙尔尼尔归来">
            <outline text="掷出往返战锤，一路落雷 → 多 2 把战锤，回手时大雷爆" />
          </outline>
          <outline text="雷暴云 → 觉醒·山羊战车">
            <outline text="随身雷云连续落雷 → 全屏覆盖，落雷速度翻倍" />
          </outline>
          <outline text="静电场 → 觉醒·雷神之域">
            <outline text="感电敌人相连成电网 → 敌人死亡引爆相连电网" />
          </outline>
          <outline text="觉醒共同效果：受击时 30% 几率反劈雷" />
        </outline>
        <outline text="奥丁 · 众神之父｜印记、贯穿、召唤">
          <outline text="基础：符文飞弹；符文 3 层引爆" />
          <outline text="四个强化方向：符文增殖＝数量；破甲符文＝穿透；符文共鸣＝扩散；回旋符文＝折返分裂" />
          <outline text="冈格尼尔 → 觉醒·永不落空">
            <outline text="长枪贯穿并引爆印记 → 自动转向，连续贯穿 3 次" />
          </outline>
          <outline text="渡鸦 → 觉醒·至高王座">
            <outline text="渡鸦俯冲叠印记 → 渡鸦 +2，啄死精英可化为英灵" />
          </outline>
          <outline text="九夜符文 → 觉醒·世界树之秘">
            <outline text="地面符文阵持续伤害与叠印记 → 阵更大更久，引爆传播印记" />
          </outline>
          <outline text="觉醒共同效果：每击杀 100 个敌人召唤英灵 20 秒" />
        </outline>
        <outline text="洛基 · 诡计之神｜灼烧、迷惑、分身">
          <outline text="基础：诡火；身边火焰持续灼烧" />
          <outline text="四个强化方向：野火蔓延＝范围；余烬＝持续；银舌＝迷惑；火种＝死亡传播" />
          <outline text="狼之父 → 觉醒·芬里尔">
            <outline text="幼狼跟随扑咬并点燃 → 巨狼喷出狼嚎火焰，迷惑沿途敌人" />
          </outline>
          <outline text="变形者 → 觉醒·千面">
            <outline text="留下诱敌火焰分身 → 同时 3 个分身，消失时迷惑" />
          </outline>
          <outline text="纳吉尔法尔之路 → 觉醒·苏尔特之火">
            <outline text="移动留下火路 → 更持久，宽度随击杀增长" />
          </outline>
          <outline text="觉醒共同效果：被迷惑的敌人死亡时爆炸" />
        </outline>
        <outline text="弗蕾亚 · 爱与战争女神｜环绕、防护、治疗">
          <outline text="基础：女武神之羽；环绕羽刃，拣选目标死亡可能掉治疗金羽" />
          <outline text="四个强化方向：羽翼丰满＝数量；展翼＝半径／转速；金羽＝治疗掉落；羽盾＝挡弹" />
          <outline text="鹰羽披风 → 觉醒·弗尔克范格">
            <outline text="羽刃向外射出再返回 → 首次命中分裂成 3 片小羽刃" />
          </outline>
          <outline text="布里辛嘉曼 → 觉醒·金泪">
            <outline text="金色光环减速并命中回血 → 受伤掉金泪，拾取回复 15% 生命" />
          </outline>
          <outline text="战猫车 → 觉醒·女神出征">
            <outline text="战猫巡逻扑击与拣选 → 女神猫车周期性横穿战场" />
          </outline>
          <outline text="觉醒共同效果：本局获得 1 次复活" />
        </outline>
        <outline text="巴德尔 · 光明之神｜贯穿、光痕、护盾">
          <outline text="基础：圣光；朝敌人最密集方向发射贯穿光束" />
          <outline text="四个强化方向：棱光＝数量；光辉＝长度／宽度；余晖＝地面光带；折射＝二次光束" />
          <outline text="光明之矛 → 觉醒·神之光矛">
            <outline text="高伤害贯穿光矛 → 首次命中炸开十字光" />
          </outline>
          <outline text="白昼 → 觉醒·永昼">
            <outline text="旋转光柱工作 3 秒后进入冷却 → 光柱 +2" />
          </outline>
          <outline text="万物之誓 → 觉醒·无伤之神">
            <outline text="命中叠护盾，最多 3 层，满盾光束增伤 → 满盾触发短暂无敌与光束强化" />
          </outline>
          <outline text="觉醒共同效果：每 30 秒全屏挂光痕" />
        </outline>
        <outline text="澜 · 海之女神｜聚怪、范围增伤、召唤">
          <outline text="基础：澜之网；聚拢定住敌人，溺水目标受范围伤害 +20%" />
          <outline text="四个强化方向：大网＝半径；双网＝数量；漩涡＝残留聚怪；拖曳＝定身时长" />
          <outline text="九浪 → 觉醒·九位浪女">
            <outline text="巨浪推动敌人后拍下 → 周期性九道浪从四周涌来" />
          </outline>
          <outline text="安德瓦利之网 → 觉醒·安德瓦利的黄金">
            <outline text="留网持续伤害，网内击杀经验翻倍 → 金网增伤，偶尔掉奖励点" />
          </outline>
          <outline text="溺亡者 → 觉醒·澜的殿堂">
            <outline text="网内击杀生成临时溺亡者，最多 6 个 → 上限 12 个且不会自然消失" />
          </outline>
          <outline text="觉醒共同效果：受伤时 20% 几率把攻击者拖入网中" />
        </outline>
        <outline text="弗雷 · 丰饶之神｜自动追击、经验、续航">
          <outline text="基础：自战之剑；自动追敌，剑击杀经验 +50%，可能掉治疗苹果" />
          <outline text="四个强化方向：双生剑＝数量；剑之舞＝速度；丰饶＝击杀经验；苹果＝治疗掉落" />
          <outline text="古林博斯帝 → 觉醒·金鬃冲锋">
            <outline text="飞剑变为冲撞野猪 → 周期性野猪群冲锋" />
          </outline>
          <outline text="丰收之地 → 觉醒·华纳海姆之春">
            <outline text="攻击累积生长治疗／减速麦田 → 麦田跟随玩家" />
          </outline>
          <outline text="阳光之剑 → 觉醒·三柄阳剑">
            <outline text="飞剑留下灼烧光痕 → 飞剑 +2，光痕持续更久" />
          </outline>
          <outline text="觉醒共同效果：每分钟回复 15% 生命" />
        </outline>
        <outline text="斯卡蒂 · 冬与狩猎女神｜远射、冻结、移动输出">
          <outline text="基础：霜猎之箭；穿透冰箭，霜冻 5 层冻结" />
          <outline text="四个强化方向：连珠＝数量；寒意＝冰箭霜冻层数；冰原＝地面结冰；碎冰＝击杀冰片" />
          <outline text="狩猎本能 → 觉醒·群山之女">
            <outline text="标记最强敌人，蓄力高伤狙击并直接冻结 → 狙击贯穿全屏，冻结沿途" />
          </outline>
          <outline text="雪鞋 → 觉醒·滑雪猎手">
            <outline text="移动距离触发射箭 → 闪现后 3 秒箭数翻倍" />
          </outline>
          <outline text="永冬 → 觉醒·芬布尔之冬">
            <outline text="随身暴风雪持续叠霜冻 → 暴风雪扩大至全屏" />
          </outline>
          <outline text="觉醒共同效果：免疫减速；寒意强化只作用冰箭，永冬每次仍叠 1 层" />
        </outline>
        <outline text="融合技｜两位神均觉醒才触发">
          <outline text="托尔＋奥丁：父子雷符 → 雷击引爆符文并向周围传播印记" />
          <outline text="托尔＋洛基：乌特加尔德之旅 → 灼烧雷爆，诡火区域追加小雷" />
          <outline text="托尔＋弗蕾亚：假新娘 → 闪现后隐身 2 秒，结束时巨雷" />
          <outline text="托尔＋斯卡蒂：碎冰之雷 → 雷击冻结目标产生冰片与霜冻传播" />
          <outline text="奥丁＋洛基：血誓兄弟 → 符文点燃，迷惑目标持续叠印记" />
          <outline text="奥丁＋弗蕾亚：英灵殿与弗尔克范格 → 精英死亡召唤英灵 15 秒" />
          <outline text="奥丁＋巴德尔：巴德尔之梦 → 光束引爆印记，符文附加光痕" />
          <outline text="洛基＋巴德尔：槲寄生 → 光束点燃，双状态击杀射出贯穿箭" />
          <outline text="洛基＋斯卡蒂：毒蛇之刑 → 灼烧叠霜冻，冻结目标灼烧翻倍" />
          <outline text="洛基＋澜：安德瓦利 → 网内点燃，烧死可能掉奖励点" />
          <outline text="弗蕾亚＋弗雷：华纳双子 → 羽刃离身追击，飞剑附加拣选" />
          <outline text="托尔＋澜：钓巨蛇 → 一个溺水目标中雷，所有溺水目标一起受雷" />
        </outline>
      </outline>
      <outline text="06 · 篇章、地图与敌人">
        <outline text="篇章一 · 诸神黄昏">
          <outline text="三关均已登记并接入当前代码；通关上一关解锁下一关" />
          <outline text="每关独立从 1 级构筑；不继承上一关等级、卡牌与信仰" />
          <outline text="普通敌人随时间增加血量与伤害；第三关成长更陡" />
          <outline text="精英规则：基础生命 ×6、移速 ×1.2、伤害 ×1.5、经验 15" />
        </outline>
        <outline text="第一关 · 芬布尔之冬｜米德加尔特">
          <outline text="地图：4608 × 4608；雪原、村庄、峡湾、石阵、墓丘、冰湖" />
          <outline text="敌群：尸鬼、冬狼、冰霜精魂、霜巨人斥候" />
          <outline text="03:00 · 斯库尔：侧向绕位扑咬、吞日缩视野、强化狼群" />
          <outline text="06:00 · 哈提：月影分身、恐惧嚎叫；斯库尔死后狂暴" />
          <outline text="09:00 · 赫列姆：践踏、冰柱牢笼、正面巨盾、召唤霜巨人" />
          <outline text="支线池：9 普通＋4 隐藏；每局普通支线抽取最多 3 个" />
          <outline text="通关额外奖励：300 奖励点；解锁第二关" />
        </outline>
        <outline text="第二关 · 亡者之船｜赫尔海姆">
          <outline text="地图：4608 × 4608；亡者广场、吉欧尔桥、冥河、港口、冥雾、大厅、树根、洞窟、工坊" />
          <outline text="地形压力：冥河需走桥或浅滩，冥雾造成持续伤害" />
          <outline text="敌群：成群亡者、吸血幽魂、会闪避的黑暗精灵、死亡分裂的指甲傀儡" />
          <outline text="03:00 · 加姆：三段扑咬、吠叫驱散；打断 4 根锁桩后挣脱" />
          <outline text="06:00 · 尼德霍格：潜地突袭、毒息毒池、啃根回血；输出可打断" />
          <outline text="09:00 · 海拉：生死二相、亡者召唤、收缩领域、亡者之船弹幕" />
          <outline text="支线池：6 普通＋3 隐藏；每局普通支线抽取最多 3 个" />
          <outline text="通关额外奖励：400 奖励点；解锁第三关" />
        </outline>
        <outline text="第三关 · 最后之战｜维格利德">
          <outline text="地图：5120 × 5120；燃烧平原、彩虹桥残端、巨人残骸、霜巨人残部、穆斯贝尔前线" />
          <outline text="敌群：亡者、火焰巨人、霜巨人精锐、狂狼战士" />
          <outline text="火焰巨人：死亡爆炸并留下火地；霜巨人精锐：冲锋、正面举盾；狂狼战士：残血狂暴" />
          <outline text="03:00 · 耶梦加得：只有蛇头受伤，蛇身撞飞，收紧包围，喷毒" />
          <outline text="06:00 · 芬里尔：吸引吞噬、绕圈奔袭；拾取格莱普尼尔碎片可束缚" />
          <outline text="09:00 · 苏尔特：炎剑横扫、召唤火巨人；60% 九界燃烧，25% 终焉符文安全格" />
          <outline text="无普通支线、无隐藏支线；重心为战场援助与命运事件" />
          <outline text="全部 Boss 击败 → 篇章结局字幕 → 通关结算" />
          <outline text="通关额外奖励：500 奖励点" />
        </outline>
        <outline text="第三关 · 改写命运">
          <outline text="托尔获救：信仰托尔＋巨蛇遭遇战用时不超过 90 秒击败；不要求托尔觉醒" />
          <outline text="托尔后续：苏尔特战每 6 秒额外落雷援助" />
          <outline text="维达介入：奥丁觉醒＋芬里尔巨口战斗触发；实际撕口后记录" />
          <outline text="弗雷参战：弗蕾亚觉醒＋进入苏尔特战；援军到场后记录，每 4 秒治疗 6% 最大生命" />
          <outline text="普通神明援助：附近有交战时，每约 14 秒轮流请一位已信仰的神出手" />
          <outline text="命运结果参与展示与持久记录；当前每项额外奖励点配置为 0" />
          <outline text="本局信仰过洛基：通关结算有额外伏笔文本" />
        </outline>
      </outline>
      <outline text="07 · 支线、探索与补给">
        <outline text="支线共同规则">
          <outline text="普通支线：01:40／04:30／07:30 从本关池随机抽取，Boss 在场时顺延" />
          <outline text="光柱出现后靠近接受；40 秒不接受则错过" />
          <outline text="隐藏支线：开局藏于地标，00:30 后可触发，未发现会给线索" />
          <outline text="同时最多 1 个普通支线＋1 个隐藏支线" />
          <outline text="支线可有期限与挑战代价；完成给资源或本局增益" />
          <outline text="下列“选卡”为独立奖励选择，不增加玩家等级" />
        </outline>
        <outline text="第一关 · 9 个普通支线">
          <outline text="最后的篝火：篝火附近守护累计 45 秒 → 100 点＋回满生命" />
          <outline text="奥丁的渡鸦：找到并安抚两只渡鸦 → 剧情点 1＋80 点；信仰奥丁额外选卡，否则大招能量 +50%" />
          <outline text="瓦尔基里的试炼：加快刷怪，60 秒内击杀 150 个敌人 → 100 点＋选卡" />
          <outline text="死者的指甲：收集 30 个指甲 → 剧情点 1＋80 点" />
          <outline text="冰下的战士：限时打碎冰块 → 100 点＋选卡" />
          <outline text="霜巨人的祭司：击杀祭司 → 120 点＋宝箱" />
          <outline text="芬布尔寒潮：围绕火盆保持体温，撑过 60 秒 → 100 点＋选卡" />
          <outline text="命运之线：从灰线与另外两条随机线中选一条">
            <outline text="灰：无代价，60 点" />
            <outline text="金：60 秒刷怪速度翻倍，成功得 200 点" />
            <outline text="银：失去 40% 当前生命，换一次选卡" />
            <outline text="黑：最大生命 -25%，换一次复活" />
            <outline text="白：本局经验倍率 ×0.8，选项数 +1" />
          </outline>
          <outline text="太阳的余烬：搬运余烬至符文石阵 → 大招充满＋100 点" />
        </outline>
        <outline text="第一关 · 4 个隐藏支线">
          <outline text="遗落的鱼竿｜冰湖：累计钓鱼 20 秒 → 随机全回复／钱袋／选卡／鳞片剧情点；信仰托尔提高鳞片权重" />
          <outline text="路标石的符文｜十字路口：触摸三处符文 → 沿途奖励点，本局全伤害 +15%、全攻击冷却 -10%" />
          <outline text="冰海来客｜峡湾码头：追杀逃向冰海的巨人 → 剧情点 1＋80 点＋宝箱" />
          <outline text="沉睡的英灵｜墓丘：依次唤醒三块墓碑 → 50 点＋英灵助战 60 秒" />
        </outline>
        <outline text="第二关 · 6 个普通支线">
          <outline text="引魂灯｜亡者广场：点亮四盏灯 → 80 点＋本局冥雾伤害减半" />
          <outline text="守桥人的盘问｜吉欧尔桥：守桥累计 40 秒 → 100 点＋选卡" />
          <outline text="斩断锚链｜港口：打断四根锚链 → 海拉晚 45 秒到场，血量 -20%" />
          <outline text="巴德尔的低语｜海拉大厅：护送灵魂 → 80 点＋本局 1 次复活" />
          <outline text="拉塔托斯克的流言｜世界树根：追逐并抓住松鼠 → 剧情点 1＋选卡" />
          <outline text="指甲堆｜工坊：摧毁五堆指甲 → 60 点＋海拉弹幕减少 30%" />
        </outline>
        <outline text="第二关 · 3 个隐藏支线">
          <outline text="八足的蹄印｜大厅：沿蹄印寻找马蹄铁 → 60 点＋本局移速 +15%" />
          <outline text="冥河里的刀剑｜浅滩：凿冰累计 15 秒取剑 → 40 点＋基础武器伤害 +20%" />
          <outline text="不肯哭泣的女巨人｜洞窟：识破并击败女巨人 → 剧情点 1＋100 点；已信仰洛基再得信仰 +1" />
        </outline>
        <outline text="战斗掉落与补给">
          <outline text="经验宝石：拾取后按经验倍率入账；精英、非最终 Boss 奖励大经验" />
          <outline text="宝箱：非最终 Boss、部分支线掉落；打开获得一次独立选卡" />
          <outline text="治疗蜜酒：回复 8 生命，满血时不消耗" />
          <outline text="聚魂磁石：吸引场上经验宝石，满级不消耗" />
          <outline text="守护符文：8 秒内抵挡一次普通直接伤害；不抵挡持续伤害与最大生命级致命判定" />
          <outline text="神术专属治疗：金羽、苹果、金泪等，由相应技能触发" />
          <outline text="补给有掉落冷却、场上上限与保底规则" />
        </outline>
      </outline>
      <outline text="08 · 局外养成、经济与收藏">
        <outline text="两种货币">
          <outline text="奖励点：Boss、支线、特定神术掉落、存活结算、通关奖励" />
          <outline text="存活收益：每完整存活 1 分钟结算 15 点" />
          <outline text="支线剧情点：特定支线与隐藏奖励；当前明确用途为法师解锁" />
          <outline text="通关额外奖励：第一关 300／第二关 400／第三关 500 点" />
          <outline text="命运额外奖励：当前配置为 0；与结算展示分开理解" />
        </outline>
        <outline text="永久强化 · 输出与生存">
          <outline text="体质强化：每级最大生命 +10；上限 5；首级 60 点" />
          <outline text="力量强化：每级全伤害 +5%；上限 5；首级 80 点" />
          <outline text="敏捷强化：每级移速加成 +4%；上限 5；首级 60 点" />
          <outline text="专注：每级全攻击冷却降低 3%；上限 3；首级 100 点" />
          <outline text="恢复：每级每秒回血 +0.2；上限 3；首级 80 点" />
        </outline>
        <outline text="永久强化 · 成长与容错">
          <outline text="感知：每级拾取范围加成 +10%；上限 3；首级 40 点" />
          <outline text="成长：每级经验 +5%；上限 5；首级 70 点" />
          <outline text="命运的偏爱：每级高稀有度概率加成 +2 个百分点；上限 5；首级 80 点" />
          <outline text="命运重抽：每级每局重抽 +1；上限 3；首级 120 点" />
          <outline text="主神的眷顾：每局复活 +1，复活半血；上限 1；价格 500 点" />
          <outline text="购买价格：第 n 级＝首级价格 × n；永久强化在每局开局应用" />
        </outline>
        <outline text="进度与解锁">
          <outline text="角色：剑士初始；枪手累计通关 1 次；刺客累计完成 3 支线；法师消耗 3 剧情点" />
          <outline text="关卡：依次解锁，已通关关卡可重新挑战" />
          <outline text="跨局保留：货币、永久强化、角色／关卡解锁、图鉴、命运记录、战绩" />
          <outline text="跨局重置：等级经验、信仰、质变觉醒、融合、选卡、本局临时状态" />
        </outline>
        <outline text="图鉴与统计">
          <outline text="四类图鉴：敌人、Boss、支线剧情、强化" />
          <outline text="记录：发现情况、击杀／击败／完成／选择次数" />
          <outline text="战绩：轮回次数、通关次数、最长存活、最快通关、累计击杀、累计支线" />
          <outline text="命运：按关卡长期保留曾经触发的结果，并保留曾信仰洛基记录" />
        </outline>
      </outline>
      <outline text="09 · 世界观与后续内容边界">
        <outline text="故事核心｜设定文档">
          <outline text="方舟：从“任何数据不得丢失”的灾备原则，走向保存与重演文明" />
          <outline text="博物馆：把神话、史诗与历史重建为可体验的世界" />
          <outline text="林溯：第零号展品，意识备份，博物馆的见证者" />
          <outline text="守墓人：投放见证者、重置世界、记录运行；游戏中称“主神”" />
          <outline text="化身：林溯穿上的档案人物身体；只用职业名，不点明具体原型人物" />
          <outline text="重写本：藏在运行记录里的记忆与技艺，对应永久成长" />
        </outline>
        <outline text="当前篇章故事">
          <outline text="芬布尔之冬：末日预兆、日月被追、寒冬与巨人" />
          <outline text="亡者之船：进入冥界，阻止纳吉尔法尔与海拉" />
          <outline text="最后之战：诸神与巨人决战，击败苏尔特，迎接九界新生" />
          <outline text="改写预言：玩家信仰选择影响神明援助与结算命运记录" />
          <outline text="洛基伏笔：通关前曾信仰洛基，提示其可能进入别的世界" />
        </outline>
        <outline text="长线叙事｜尚未作为完整可玩篇章接入">
          <outline text="博物馆层次：神话层 → 史诗与古国 → 历史层 → 最后一日" />
          <outline text="裂缝：重置未覆盖的痕迹，引出对轮回真相的察觉" />
          <outline text="终章构想：利用重启时外部热备份的 0.3 秒窗口逃离" />
          <outline text="上述为剧情设定，不等于当前游戏已实现这些场景与机制" />
        </outline>
        <outline text="后续篇章候选｜设计储备">
          <outline text="西行：黑风山至白虎岭 → 火焰山 → 狮驼岭；护送玩法构想" />
          <outline text="封神：十绝阵 → 诛仙阵 → 万仙阵；阵法规则构想" />
          <outline text="山海经：南山 → 西海 → 不周山；异兽捕捉构想" />
          <outline text="其他储备：奥林匹斯、百鬼夜行、旧日支配者" />
          <outline text="最后一日：无本土神明可借力的终章设想" />
          <outline text="正式关卡改为约 15 分钟：未来节奏计划，当前未启用" />
        </outline>
      </outline>
      <outline text="10 · 人工审阅重点与现有差异">
        <outline text="职业差异">
          <outline text="法师“先知”仍写四选一，但四职业当前都四选一；需人工决定其最终被动定位" />
          <outline text="不将法师擅自改成五选一，本导图按当前代码记录" />
          <outline text="刺客“破阵”实际加成在双刃伤害计算中；职业说明的“伤害”范围需统一" />
          <outline text="刺客“三连刺”卡实际追加一击，命名与攻击次数需人工核对" />
        </outline>
        <outline text="成长资源">
          <outline text="40 级、4 神、每神 11 张强化到觉醒之间存在选择预算取舍" />
          <outline text="宝箱／支线能补充选卡；第三关无支线，构筑节奏不能直接套用前两关" />
          <outline text="稀有度提高效果强度，但每张神明强化仍只加 1 信仰" />
          <outline text="全伤害、武器伤害、神术冷却、武器冷却应分开审阅" />
        </outline>
        <outline text="旧文档与代码差异">
          <outline text="旧入口仍有“第三关待实施”；当前三关均已登记并接入" />
          <outline text="旧世界观有“支线不影响 Boss”；当前锚链与指甲堆会改变海拉战" />
          <outline text="旧世界观有“失败没有代价”；命运之线与部分挑战有当场成本，应逐项理解" />
          <outline text="旧冲刺文字为瞬移与落地 0.2 秒保护；当前为 0.14 秒快速冲刺＋落地 0.12 秒保护" />
          <outline text="旧文本可能出现三选一；普通升级当前四选一，神明质变仍三选一" />
          <outline text="命运展示已接入，但额外奖励点当前为 0，不应写成已有加分" />
        </outline>
        <outline text="阅读与验证边界">
          <outline text="职业、属性、成长、关卡、奖励：按当前代码静态梳理" />
          <outline text="神术详细分支：按当前卡牌说明组织；具体运行数值以对应神术脚本为准" />
          <outline text="世界观与未来篇章：明确按设定归类，不计入当前可玩内容" />
          <outline text="本次制作导图，不修改战斗逻辑，不视作完整通关或平衡验收" />
        </outline>
      </outline>
      <outline text="来源索引">
        <outline text="职业：scripts/data/character_db.gd；scripts/weapons/；scripts/ultimates/" />
        <outline text="属性／成长：scripts/entities/player.gd；scripts/data/upgrade_db.gd；scripts/game.gd" />
        <outline text="神明／融合：scripts/data/gods.gd；scripts/gods/；scripts/entities/enemy.gd" />
        <outline text="关卡／敌人：scripts/data/level_db.gd；scripts/data/enemy_db.gd；scripts/data/codex_db.gd；scripts/bosses/" />
        <outline text="支线：scripts/data/quest_db.gd；scripts/quests/" />
        <outline text="战场命运：scripts/world/vigrid_battle.gd；scripts/data/vigrid_tuning.gd；第三关 Boss 脚本" />
        <outline text="补给：scripts/data/supply_db.gd；scripts/entities/run_supply.gd" />
        <outline text="局外：scripts/data/meta_db.gd；scripts/core/save_data.gd；scripts/ui/hub.gd" />
        <outline text="世界观：docs/世界观设定.md；docs/角色设定.md；docs/局内成长与关卡节奏.md" />
      </outline>
    </outline>
  </body>
</opml>